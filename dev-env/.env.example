# Settings for compose.yaml. Copy this file to .env in this folder and
# change what you need; Compose reads .env on every command, and without
# it the defaults below apply. README.md describes each setting.

# The host address every backend port is published on. 0.0.0.0 publishes
# on every interface; the backends have no API key.
BIND_ADDRESS=127.0.0.1

# A host folder for the model files. Empty uses the
# ai-model-facade-dev_models volume.
MODELS_DIR=

# true keeps the backends running when control's container stops, such as
# for `docker compose up --build` after a change to control; the setting of
# the container that stops is the one that counts.
KEEP_BACKENDS=

# Host ports, one per service. control's is always on 127.0.0.1.
CONTROL_PORT=18090
LLAMA_SERVER_ROUTER_PORT=18080
LLAMA_SERVER_SINGLE_PORT=18081
LLAMA_SWAP_PORT=18082
OLLAMA_PORT=18083
OPEN_WEBUI_PORT=18084
LM_STUDIO_PORT=18085
